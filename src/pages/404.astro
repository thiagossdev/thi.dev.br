---
import Base from '../layouts/Base.astro';
import Ui from '../components/icons/Ui.astro';
import { homePath } from '../i18n/config';
---

<Base title="404 · thi.dev.br" description="Page not found." alternates={false}>
  <section class="wrap py-24">
    <p class="text-sm text-text-muted">
      <span class="text-brand">thiago@thi.dev.br</span>:<span class="text-blue">~</span>$ cd <span id="path">…</span>
    </p>
    <h1 class="mt-3 text-2xl font-bold tracking-[-0.012em] text-text sm:text-3xl">
      bash: cd: <span class="text-red">No such file or directory</span>
    </h1>
    <p class="mt-6 max-w-[62ch] text-base text-text-secondary">
      This path does not exist here. Head back home or take a look at the projects.
    </p>
    <p class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      <a href={homePath('en')} class="link inline-flex items-center gap-2"><Ui name="house" class="size-4 text-brand" />cd ~</a>
      <a href={`${homePath('en')}#projects`} class="link text-text-secondary">projects</a>
      <a href={homePath('pt-br')} lang="pt-BR" class="link text-text-secondary">início em português</a>
      <a href={homePath('es')} lang="es" class="link text-text-secondary">inicio en español</a>
    </p>
  </section>
</Base>

<script>
  const el = document.getElementById('path');
  if (el) el.textContent = location.pathname;
</script>
