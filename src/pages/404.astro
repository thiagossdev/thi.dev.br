---
import Base from '../layouts/Base.astro';
import Ui from '../components/icons/Ui.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title="404 · thi.dev.br" description="Página não encontrada.">
  <section class="mx-auto max-w-4xl px-4 py-24 sm:px-6">
    <p class="text-sm text-text-muted">
      <span class="text-brand">thiago@thi.dev.br</span>:<span class="text-blue">~</span>$ cd <span id="path">…</span>
    </p>
    <h1 class="mt-3 text-2xl font-bold tracking-[-0.012em] text-text sm:text-3xl">
      bash: cd: <span class="text-red">No such file or directory</span>
    </h1>
    <p class="mt-6 max-w-[62ch] text-base text-text-secondary">
      Esse caminho não existe por aqui. Volte para o início ou dê uma olhada nos projetos.
    </p>
    <p class="mt-8 flex flex-wrap gap-x-5 text-sm">
      <a href={base} class="link inline-flex items-center gap-2"><Ui name="house" class="size-4 text-brand" />cd ~</a>
      <a href={`${base}#projetos`} class="link text-text-secondary">projetos</a>
    </p>
  </section>
</Base>

<script>
  const el = document.getElementById('path');
  if (el) el.textContent = location.pathname;
</script>
