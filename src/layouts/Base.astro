---
import '../styles/global.css';
import { site } from '../data/site';
import { homePath, localeMeta, locales, defaultLocale, type Locale } from '../i18n/config';
import { t } from '../i18n/strings';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  /** false em páginas sem versão por idioma, como a 404 */
  alternates?: boolean;
}

const { locale = defaultLocale, alternates = true } = Astro.props;
const s = t(locale);
const { title = s.meta.title, description = s.meta.description } = Astro.props;
const meta = localeMeta[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}og.jpg`, Astro.site);
---

<!doctype html>
<html lang={meta.htmlLang} data-theme="tokyo-night">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Tema antes da primeira pintura: escolha salva ou preferência do sistema.
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'latte' && theme !== 'tokyo-night') {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'latte' : 'tokyo-night';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#1a1b26" />
    <link rel="canonical" href={canonical} />
    {
      alternates && (
        <>
          {locales.map((l) => (
            <link rel="alternate" hreflang={localeMeta[l].htmlLang} href={new URL(homePath(l), Astro.site)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(homePath(defaultLocale), Astro.site)} />
        </>
      )
    }
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)}
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={`@${site.handle}`} />
  </head>
  <body class="bg-bg text-text min-h-dvh flex flex-col">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-xs focus:bg-brand-fill focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-brand-ink"
    >
      {s.a11y.skip}
    </a>
    <Header locale={locale} />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // Digita os títulos de seção quando entram na tela (efeito do omarchy.org).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const blocks = [...document.querySelectorAll<HTMLElement>('[data-typed]')];

      if (!reduce && 'IntersectionObserver' in window) {
        const type = (block: HTMLElement) => {
          const full = block.dataset.typed ?? '';
          const out = block.querySelector<HTMLElement>('[data-typed-text]');
          if (!out) return;
          block.dataset.typing = '1';
          let i = 0;
          const step = () => {
            i += 1;
            out.textContent = full.slice(0, i);
            if (i < full.length) {
              setTimeout(step, 45 + Math.random() * 40);
            } else {
              block.dataset.typing = '0';
              setTimeout(() => (block.dataset.typing = 'done'), 2400);
            }
          };
          setTimeout(step, 120);
        };

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              io.unobserve(entry.target);
              type(entry.target as HTMLElement);
            }
          },
          { rootMargin: '0px 0px -15% 0px' },
        );

        for (const block of blocks) {
          const out = block.querySelector<HTMLElement>('[data-typed-text]');
          if (out) out.textContent = '';
          io.observe(block);
        }
      } else {
        for (const block of blocks) block.dataset.typing = 'done';
      }
    </script>
  </body>
</html>
