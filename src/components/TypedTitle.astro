---
// Título de seção "digitado" quando entra na tela, como no omarchy.org.
// O texto completo fica no HTML (e para leitores de tela); o script em
// Base.astro só reescreve a parte visível. Sem JS ou com movimento
// reduzido, o título aparece inteiro.
interface Props {
  id: string;
  text: string;
}
const { id, text } = Astro.props;
---

<h2 class="section-title text-balance">
  <a href={`#${id}`} class="text-inherit no-underline">
    <span class="sr-only">{text}</span>
    <span aria-hidden="true" data-typed={text} data-typing="0"><span data-typed-text>{text}</span><span class="typed-caret"></span></span>
  </a>
</h2>
