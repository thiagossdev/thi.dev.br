---
interface Props {
  id: string;
  title: string;
  lead?: string;
}
const { id, title, lead } = Astro.props;
---

<section id={id} class="wrap scroll-mt-20 py-8 sm:py-12">
  <div class="border-t border-border-subtle pt-8 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12">
    <header class="lg:sticky lg:top-24 lg:self-start">
      <h2 class="section-title">{title}</h2>
      {lead && <p class="mt-2 max-w-[62ch] text-sm text-text-muted lg:max-w-none">{lead}</p>}
    </header>
    <div class="mt-8 lg:mt-0">
      <slot />
    </div>
  </div>
</section>
