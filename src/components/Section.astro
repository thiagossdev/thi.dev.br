---
// Seção no modelo do omarchy.org: faixa de largura total com borda no topo,
// fundo alternado (tone="deep") e conteúdo no container .wrap.
import TypedTitle from './TypedTitle.astro';

interface Props {
  id: string;
  title: string;
  lead?: string;
  tone?: 'base' | 'deep';
}
const { id, title, lead, tone = 'base' } = Astro.props;
---

<section id={id} class:list={['scroll-mt-14 border-t border-border-subtle', tone === 'deep' && 'bg-bg-deep']}>
  <div class="wrap py-12 lg:py-24">
    <header class="max-w-xl">
      <TypedTitle id={id} text={title} />
      {lead && <p class="mt-2 text-[15px] leading-relaxed text-text-secondary text-pretty">{lead}</p>}
    </header>
    <div class="mt-6 lg:mt-10">
      <slot />
    </div>
  </div>
</section>
