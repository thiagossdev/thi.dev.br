---
interface Props {
  id: string;
  title: string;
  lead?: string;
}
const { id, title, lead } = Astro.props;
---

<section id={id} class="mx-auto max-w-4xl scroll-mt-20 px-4 py-8 sm:px-6 sm:py-12">
  <div class="border-t border-border-subtle pt-8">
    <h2 class="section-title">{title}</h2>
    {lead && <p class="mt-2 max-w-[62ch] text-sm text-text-muted">{lead}</p>}
    <div class="mt-8">
      <slot />
    </div>
  </div>
</section>
