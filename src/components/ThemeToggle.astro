---
// Alterna entre Tokyo Night (escuro) e Catppuccin Latte (claro).
// O tema inicial é aplicado por um script inline no <head> (Base.astro),
// antes da primeira pintura, para não piscar.
import Moon from '@lucide/astro/icons/moon';
import Sun from '@lucide/astro/icons/sun';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/strings';

interface Props {
  locale: Locale;
}
const s = t(Astro.props.locale);
---

<button
  type="button"
  data-theme-toggle
  aria-label={s.a11y.theme}
  title={s.a11y.theme}
  class="inline-flex size-10 items-center justify-center rounded-sm text-text-secondary transition-[background-color,color] duration-150 ease-out [@media(hover:hover)]:hover:bg-surface-2 [@media(hover:hover)]:hover:text-text"
>
  <Sun class="theme-icon-light size-[18px]" stroke-width={1.5} stroke-linecap="square" aria-hidden="true" />
  <Moon class="theme-icon-dark size-[18px]" stroke-width={1.5} stroke-linecap="square" aria-hidden="true" />
</button>

<script>
  const THEME_COLORS: Record<string, string> = { 'tokyo-night': '#1a1b26', latte: '#eff1f5' };

  const apply = (theme: string) => {
    document.documentElement.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', THEME_COLORS[theme] ?? '#1a1b26');
    for (const b of document.querySelectorAll('[data-theme-toggle]')) {
      b.setAttribute('aria-pressed', String(theme === 'latte'));
    }
    window.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
  };

  apply(document.documentElement.dataset.theme ?? 'tokyo-night');

  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'latte' ? 'tokyo-night' : 'latte';
      try {
        localStorage.setItem('theme', next);
      } catch {}
      apply(next);
    });
  }
</script>
