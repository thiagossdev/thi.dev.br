---
import { site } from '../data/site';
import Brand from './icons/Brand.astro';
import Ui from './icons/Ui.astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/strings';

interface Props {
  locale: Locale;
}
const s = t(Astro.props.locale);
const year = new Date().getFullYear();
---

<footer id="contact" class="wrap scroll-mt-20 pt-8 pb-10 sm:pt-12">
  <div class="border-t border-border-subtle pt-8 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12">
    <h2 class="section-title">{s.nav.contact}</h2>
    <div>
    <p class="mt-4 lg:mt-0 max-w-[62ch] text-sm leading-relaxed text-text-secondary">
      {s.contact.lead}
    </p>
    <p class="mt-3 flex items-center gap-2 text-base">
      <Ui name="mail" class="size-5 shrink-0 text-brand" />
      <a href={`mailto:${site.email}`} class="link font-semibold">{site.email}</a>
    </p>

    <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label={s.a11y.social}>
      {
        site.links.map((l) => (
          <li>
            <a href={l.href} rel="me noopener" target="_blank" class="link inline-flex items-center gap-2 text-text-secondary">
              <Brand name={l.icon} class="size-4" />
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-12 flex flex-wrap gap-x-2 text-xs text-text-muted">
      <span>© {year} {site.name}.</span>
      <span>
        {s.contact.builtWith} <a href="https://astro.build" class="link" rel="noopener" target="_blank">Astro</a>,{' '}
        {s.contact.hostedOn}
      </span>
      <a href={site.repo} class="link" rel="noopener" target="_blank">{s.contact.source}</a>
    </p>
    </div>
  </div>
</footer>
