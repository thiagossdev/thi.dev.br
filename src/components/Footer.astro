---
import { site } from '../data/site';
import Brand from './icons/Brand.astro';
import Ui from './icons/Ui.astro';
import TypedTitle from './TypedTitle.astro';
import PixelField from './PixelField.astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/strings';

interface Props {
  locale: Locale;
}
const s = t(Astro.props.locale);
const year = new Date().getFullYear();
---

<footer id="contact" class="relative isolate scroll-mt-14 overflow-hidden border-t border-border-subtle bg-[var(--t-field-bg)] pb-[env(safe-area-inset-bottom)]">
  <PixelField />
  <div class="wrap py-12 lg:py-24">
    <header class="max-w-xl">
      <TypedTitle id="contact" text={s.nav.contact} />
      <p class="mt-2 text-[15px] leading-relaxed text-text-secondary text-pretty">{s.contact.lead}</p>
    </header>

    <div class="mt-6 lg:mt-10">
      <p class="flex items-center gap-2 text-base">
        <Ui name="mail" class="size-5 shrink-0 text-brand" />
        <a href={`mailto:${site.email}`} class="link font-semibold">{site.email}</a>
      </p>

      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label={s.a11y.social}>
        {
          site.links.map((l) => (
            <li>
              <a href={l.href} rel="me noopener" target="_blank" class="link inline-flex items-center gap-2 text-text-secondary">
                <Brand name={l.icon} class="size-4" />
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-white/5 bg-[color-mix(in_oklch,var(--t-field-bg)_82%,transparent)]">
    <p class="wrap flex flex-wrap gap-x-2 gap-y-1 py-6 text-xs text-text-muted">
      <span>© {year} {site.name}.</span>
      <span>
        {s.contact.builtWith} <a href="https://astro.build" class="link" rel="noopener" target="_blank">Astro</a>,{' '}
        {s.contact.hostedOn}
      </span>
      <a href={site.repo} class="link" rel="noopener" target="_blank">{s.contact.source}</a>
    </p>
  </div>
</footer>
