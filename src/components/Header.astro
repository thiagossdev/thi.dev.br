---
import { site } from '../data/site';
import Brand from './icons/Brand.astro';
import Ui from './icons/Ui.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const iconLinks = site.links.filter((l) => l.icon === 'github' || l.icon === 'linkedin');
---

<header class="sticky top-0 z-40 border-b border-border-subtle bg-bg/85 backdrop-blur-sm">
  <div class="mx-auto flex h-14 max-w-4xl items-center gap-6 px-4 sm:px-6">
    <a href={base} class="flex items-center gap-2 text-sm font-semibold text-text" aria-label="Início">
      <Ui name="terminal" class="size-5 text-brand" />
      <span>~/{site.shortName}</span>
    </a>

    <nav aria-label="Seções" class="hidden items-center gap-1 md:flex">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="rounded-xs px-2 py-1.5 text-sm text-text-secondary transition-[background-color,color] duration-150 ease-out [@media(hover:hover)]:hover:bg-surface-2 [@media(hover:hover)]:hover:text-text"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1">
      {
        iconLinks.map((l) => (
          <a
            href={l.href}
            rel="me noopener"
            target="_blank"
            aria-label={l.label}
            title={l.label}
            class="inline-flex size-10 items-center justify-center rounded-sm text-text-secondary transition-[background-color,color] duration-150 ease-out [@media(hover:hover)]:hover:bg-surface-2 [@media(hover:hover)]:hover:text-text"
          >
            <Brand name={l.icon} class="size-[18px]" />
          </a>
        ))
      }
    </div>
  </div>
</header>
