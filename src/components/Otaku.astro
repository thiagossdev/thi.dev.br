---
import { Image } from 'astro:assets';
import maka from '../assets/maka-albarn.png';
import Section from './Section.astro';
import Ui from './icons/Ui.astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/strings';

interface Props {
  locale: Locale;
}
const s = t(Astro.props.locale);
const o = s.otaku;
---

<Section id="otaku" title={s.nav.otaku} lead={o.lead}>
  <div class="grid items-end gap-10 md:grid-cols-[minmax(0,1fr)_17rem] lg:gap-16">
    <div class="space-y-10">
      <!-- Espelho embaçado: o número aparece como se fosse escrito com o dedo -->
      <figure class="mirror relative overflow-hidden rounded-md p-6 shadow-ring sm:p-8" data-mirror>
        <figcaption class="relative text-sm text-text-secondary">{o.mirrorLabel}</figcaption>
        <p class="relative mt-5 text-4xl font-bold tracking-[0.06em] text-text tabular-nums sm:text-5xl lg:text-6xl">
          <span class="mirror-write">42-42-564</span>
        </p>
        <p class="relative mt-5 flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <span lang="ja" class="text-2xl text-brand sm:text-3xl">死に死に殺し</span>
          <span class="text-sm text-text-muted">{o.reading}</span>
          <span class="text-sm text-text-secondary">{o.meaning}</span>
        </p>
      </figure>

      <blockquote class="max-w-[62ch]">
        <Ui name="quote" class="mb-3 size-5 text-brand" />
        <p lang="ja" class="text-lg leading-relaxed text-text sm:text-xl">健全なる魂は健全なる精神と健全なる肉体に宿る</p>
        <p class="mt-3 text-[15px] leading-relaxed text-text-secondary text-pretty">{o.quote}</p>
        <footer class="mt-2 text-xs text-text-muted">{o.quoteSource}</footer>
      </blockquote>
    </div>

    <figure class="soul-figure relative mx-auto w-56 sm:w-64 md:mx-0 md:w-full">
      <span class="soul-glow" aria-hidden="true"></span>
      <Image src={maka} alt={o.imageAlt} width={300} height={396} class="relative h-auto w-full" />
      <figcaption class="mt-3 text-center text-xs text-text-muted">{o.caption}</figcaption>
    </figure>
  </div>
</Section>

<style>
  /* Vidro embaçado: superfície com névoa clara e um brilho que passa devagar */
  .mirror {
    background:
      radial-gradient(120% 90% at 15% 10%, color-mix(in oklch, var(--t-text) 9%, transparent), transparent 60%),
      radial-gradient(90% 80% at 90% 100%, color-mix(in oklch, var(--t-brand) 8%, transparent), transparent 70%),
      var(--t-surface);
  }
  .mirror::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, color-mix(in oklch, var(--t-text) 7%, transparent) 50%, transparent 65%);
    transform: translateX(-100%);
    pointer-events: none;
  }

  /* O número é revelado da esquerda para a direita, como um dedo no vidro */
  @property --write {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }
  .mirror-write {
    --write: 100%;
    -webkit-mask-image: linear-gradient(90deg, #000 var(--write), transparent calc(var(--write) + 6%));
    mask-image: linear-gradient(90deg, #000 var(--write), transparent calc(var(--write) + 6%));
    text-shadow: 0 0 18px color-mix(in oklch, var(--t-text) 25%, transparent);
  }
  [data-mirror][data-state='waiting'] .mirror-write {
    --write: 0%;
  }
  [data-mirror][data-state='writing'] .mirror-write {
    animation: mirror-write 1.6s cubic-bezier(0.45, 0, 0.25, 1) forwards;
  }
  [data-mirror][data-state='writing']::after {
    animation: mirror-sheen 2.4s 1.2s ease-out forwards;
  }

  /* Brilho de alma atrás da Maka, pulsando devagar */
  .soul-glow {
    position: absolute;
    inset: 18% 10% 22%;
    border-radius: 9999px;
    background: radial-gradient(circle, color-mix(in oklch, var(--t-brand) 35%, transparent), transparent 70%);
    filter: blur(24px);
    animation: soul-pulse 4.2s ease-in-out infinite;
  }

  @keyframes mirror-write {
    from {
      --write: 0%;
    }
    to {
      --write: 100%;
    }
  }
  @keyframes mirror-sheen {
    to {
      transform: translateX(100%);
    }
  }
  @keyframes soul-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.96);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-mirror] .mirror-write {
      --write: 100% !important;
      animation: none !important;
    }
    .mirror::after,
    .soul-glow {
      animation: none !important;
    }
  }
</style>

<script>
  // Escreve o número no espelho quando ele entra na tela.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const mirror of document.querySelectorAll<HTMLElement>('[data-mirror]')) {
    if (reduce || !('IntersectionObserver' in window)) continue;
    mirror.dataset.state = 'waiting';
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        mirror.dataset.state = 'writing';
      },
      { rootMargin: '0px 0px -20% 0px' },
    );
    io.observe(mirror);
  }
</script>
