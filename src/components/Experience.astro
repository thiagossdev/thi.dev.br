---
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import { site } from '../data/site';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/strings';
import Ui from './icons/Ui.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale);
const e = s.experience;

const fmt = (ym: string) => {
  const [y, m] = ym.split('-').map(Number);
  return `${e.months[m - 1]} ${y}`;
};

const jobs = (await getCollection('experience')).sort((a, b) => b.data.start.localeCompare(a.data.start));
---

<Section id="experience" title={s.nav.experience} lead={e.lead}>
  <ol class="relative ml-1 border-l border-border-strong">
    {
      jobs.map(({ data }) => {
        const current = data.end === null;
        return (
          <li class="relative pb-10 pl-7 last:pb-0">
            <span
              class:list={[
                'absolute top-1.5 -left-[5px] size-[9px] rounded-full',
                current ? 'bg-brand shadow-[0_0_0_4px_var(--t-brand-soft)]' : 'bg-bg outline-1 outline-border-strong',
              ]}
              aria-hidden="true"
            />
            <p class="text-xs tabular-nums text-text-muted">
              <time datetime={data.start}>{fmt(data.start)}</time>
              <span aria-hidden="true"> – </span>
              <span class="sr-only">{s.a11y.until}</span>
              {data.end ? <time datetime={data.end}>{fmt(data.end)}</time> : <span class="text-brand">{e.present}</span>}
              <span class="mx-2 text-border-strong" aria-hidden="true">·</span>
              {data.location}
            </p>
            <h3 class="mt-1 text-base font-semibold text-text">
              {data.role[locale]}
              <span class="font-normal text-text-muted"> @ </span>
              {data.url ? (
                <a href={data.url} class="link" rel="noopener" target="_blank">
                  {data.company}
                </a>
              ) : (
                data.company
              )}
            </h3>
            <ul class="mt-3 max-w-[70ch] space-y-1.5 text-sm leading-relaxed text-text-secondary">
              {data.summary[locale].map((line) => (
                <li class="flex gap-2">
                  <span class="text-text-muted select-none" aria-hidden="true">
                    -
                  </span>
                  <span>{line}</span>
                </li>
              ))}
            </ul>
            <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={s.a11y.technologies}>
              {data.stack.map((tech) => (
                <li class="chip">{tech}</li>
              ))}
            </ul>
          </li>
        );
      })
    }
  </ol>

  <div class="mt-12 grid gap-10 md:grid-cols-2 md:gap-12">
    <figure class="self-start rounded-sm bg-surface p-5 shadow-ring">
      <Ui name="quote" class="mb-3 size-5 text-brand" />
      <blockquote class="text-sm leading-relaxed text-text-secondary">
        {e.testimonial.quote}
      </blockquote>
      <figcaption class="mt-3 text-xs text-text-muted">
        <span class="text-text">{site.testimonialAuthor}</span>, {e.testimonial.role}
        {e.testimonial.note && <span class="mt-1 block italic">{e.testimonial.note}</span>}
      </figcaption>
    </figure>

    <div>
      <h3 class="flex items-center gap-2 text-sm font-semibold text-text">
        <Ui name="graduation-cap" class="size-5 text-brand" />
        {e.education}
      </h3>
      <p class="mt-2 text-sm text-text-secondary">
        {e.degree},{' '}
        <a href={site.education.url} class="link" rel="noopener" target="_blank">{site.education.school}</a>{' '}
        <span class="text-text-muted">· {site.education.period}</span>
      </p>
      <ul class="mt-2 space-y-1 text-sm text-text-muted">
        {e.educationNotes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </div>
</Section>
