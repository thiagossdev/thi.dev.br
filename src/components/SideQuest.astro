---
import { Image } from 'astro:assets';
import maka from '../assets/maka-albarn.png';
import blackStar from '../assets/black-star.png';
import deathTheKid from '../assets/death-the-kid.png';
import lordDeath from '../assets/lord-death.png';
import Section from './Section.astro';
import Ui from './icons/Ui.astro';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/strings';

interface Props {
  locale: Locale;
}
const s = t(Astro.props.locale);
const o = s.otaku;

// Personagens que se revezam na figura, na ordem da troca.
const cast = [
  { src: maka, alt: o.imageAlt, caption: o.caption },
  { src: blackStar, alt: 'Black☆Star, Soul Eater', caption: 'Black☆Star' },
  { src: deathTheKid, alt: 'Death the Kid, Soul Eater', caption: 'Death the Kid', credit: 'Render: BLACKrangers123 (DeviantArt)' },
  { src: lordDeath, alt: 'Shinigami-sama (Lord Death), Soul Eater', caption: 'Shinigami-sama' },
];
---

<Section id="side-quest" title={s.nav.sideQuest} lead={o.lead}>
  <div class="grid items-end gap-10 md:grid-cols-[minmax(0,1fr)_17rem] lg:gap-16">
    <div class="space-y-10">
      <!-- Espelho embaçado: o número aparece como se fosse escrito com o dedo -->
      <figure class="mirror relative overflow-hidden rounded-md p-6 shadow-ring sm:p-8" data-mirror>
        <figcaption class="relative text-sm text-text-secondary">{o.mirrorLabel}</figcaption>
        <p class="relative mt-5 text-4xl font-bold tracking-[0.06em] text-text tabular-nums sm:text-5xl lg:text-6xl">
          <span class="mirror-write">42-42-564</span>
        </p>
        <p class="relative mt-5 flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <span lang="ja" class="text-2xl text-brand sm:text-3xl">死に死に殺し</span>
          <span class="text-sm text-text-muted">{o.reading}</span>
          <span class="text-sm text-text-secondary">{o.meaning}</span>
        </p>
      </figure>

      <blockquote class="max-w-[62ch]">
        <Ui name="quote" class="mb-3 size-5 text-brand" />
        <p lang="ja" class="text-lg leading-relaxed text-text sm:text-xl">健全なる魂は健全なる精神と健全なる肉体に宿る</p>
        <p class="mt-3 text-[15px] leading-relaxed text-text-secondary text-pretty">{o.quote}</p>
        <footer class="mt-2 text-xs text-text-muted">{o.quoteSource}</footer>
      </blockquote>
    </div>

    <figure class="soul-figure relative mx-auto w-56 sm:w-64 md:mx-0 md:w-full" data-cast>
      <span class="soul-glow" aria-hidden="true"></span>
      <button
        type="button"
        class="cast-stage relative block aspect-[3/4] w-full cursor-pointer [perspective:900px]"
        aria-label={o.next}
        title={o.next}
        data-cast-stage
      >
        {
          cast.map((c, i) => (
            <Image
              src={c.src}
              alt={c.alt}
              height={600}
              loading="eager"
              class:list={['cast-card absolute inset-0 m-auto h-full w-full object-contain object-bottom', i !== 0 && 'hidden']}
              data-cast-card
              data-caption={c.caption}
              title={c.credit}
            />
          ))
        }
      </button>
      <figcaption class="mt-3 text-center text-xs text-text-muted" aria-live="polite" data-cast-caption>{cast[0].caption}</figcaption>
    </figure>
  </div>
</Section>

<style>
  /* Vidro embaçado: superfície com névoa clara e um brilho que passa devagar */
  .mirror {
    background:
      radial-gradient(120% 90% at 15% 10%, color-mix(in oklch, var(--t-text) 9%, transparent), transparent 60%),
      radial-gradient(90% 80% at 90% 100%, color-mix(in oklch, var(--t-brand) 8%, transparent), transparent 70%),
      var(--t-surface);
  }
  .mirror::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, color-mix(in oklch, var(--t-text) 7%, transparent) 50%, transparent 65%);
    transform: translateX(-100%);
    pointer-events: none;
  }

  /* O número é revelado da esquerda para a direita, como um dedo no vidro */
  @property --write {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }
  .mirror-write {
    --write: 100%;
    -webkit-mask-image: linear-gradient(90deg, #000 var(--write), transparent calc(var(--write) + 6%));
    mask-image: linear-gradient(90deg, #000 var(--write), transparent calc(var(--write) + 6%));
    text-shadow: 0 0 18px color-mix(in oklch, var(--t-text) 25%, transparent);
  }
  [data-mirror][data-state='waiting'] .mirror-write {
    --write: 0%;
  }
  [data-mirror][data-state='writing'] .mirror-write {
    animation: mirror-write 1.6s cubic-bezier(0.45, 0, 0.25, 1) forwards;
  }
  [data-mirror][data-state='writing']::after {
    animation: mirror-sheen 2.4s 1.2s ease-out forwards;
  }

  /* Brilho de alma atrás da Maka, pulsando devagar */
  .soul-glow {
    position: absolute;
    inset: 18% 10% 22%;
    border-radius: 9999px;
    background: radial-gradient(circle, color-mix(in oklch, var(--t-brand) 35%, transparent), transparent 70%);
    filter: blur(24px);
    animation: soul-pulse 4.2s ease-in-out infinite;
  }

  @keyframes mirror-write {
    from {
      --write: 0%;
    }
    to {
      --write: 100%;
    }
  }
  @keyframes mirror-sheen {
    to {
      transform: translateX(100%);
    }
  }
  @keyframes soul-pulse {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.96);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-mirror] .mirror-write {
      --write: 100% !important;
      animation: none !important;
    }
    .mirror::after,
    .soul-glow {
      animation: none !important;
    }
  }
</style>

<script>
  // Troca de personagem: gira até ficar de lado, troca, completa o giro e
  // treme até estabilizar. Troca sozinha a cada 5 s e no clique; pausa com
  // o mouse em cima, com foco ou fora da tela. Com movimento reduzido, fica
  // parado no primeiro personagem.
  for (const figure of document.querySelectorAll<HTMLElement>('[data-cast]')) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) break;
    const stage = figure.querySelector<HTMLButtonElement>('[data-cast-stage]');
    const caption = figure.querySelector<HTMLElement>('[data-cast-caption]');
    const cards = [...figure.querySelectorAll<HTMLElement>('[data-cast-card]')];
    if (!stage || !caption || cards.length < 2) continue;

    // Espera a animação terminar, ou o tempo dela, o que vier primeiro, para
    // a troca nunca travar se o navegador pausar as animações.
    const run = (el: HTMLElement, frames: Keyframe[], opts: KeyframeAnimationOptions & { duration: number }) => {
      const anim = el.animate(frames, opts);
      return Promise.race([anim.finished.catch(() => {}), new Promise((r) => setTimeout(r, opts.duration + 80))]);
    };

    let index = 0;
    let busy = false;
    let paused = false;
    let visible = false;

    const flipTo = async (next: number) => {
      if (busy) return;
      busy = true;
      const current = cards[index];
      const incoming = cards[next];
      await run(current, [{ transform: 'rotateY(0deg)' }, { transform: 'rotateY(90deg)' }], {
        duration: 260,
        easing: 'cubic-bezier(0.55, 0, 1, 0.45)',
        fill: 'forwards',
      });
      current.classList.add('hidden');
      current.getAnimations().forEach((a) => a.cancel());
      incoming.classList.remove('hidden');
      caption.textContent = incoming.dataset.caption ?? '';
      await run(incoming, [{ transform: 'rotateY(-90deg)' }, { transform: 'rotateY(0deg)' }], {
        duration: 320,
        easing: 'cubic-bezier(0, 0.55, 0.45, 1)',
      });
      // Tremor amortecido até parar.
      await run(
        incoming,
        [
          { transform: 'rotate(0deg) translateX(0)' },
          { transform: 'rotate(-5deg) translateX(-6px)', offset: 0.15 },
          { transform: 'rotate(4deg) translateX(5px)', offset: 0.32 },
          { transform: 'rotate(-2.5deg) translateX(-3px)', offset: 0.5 },
          { transform: 'rotate(1.5deg) translateX(2px)', offset: 0.68 },
          { transform: 'rotate(-0.6deg) translateX(-1px)', offset: 0.84 },
          { transform: 'rotate(0deg) translateX(0)' },
        ],
        { duration: 650, easing: 'ease-out' },
      );
      index = next;
      busy = false;
    };
    const advance = () => flipTo((index + 1) % cards.length);

    stage.addEventListener('click', advance);
    for (const [on, off] of [
      ['pointerenter', 'pointerleave'],
      ['focusin', 'focusout'],
    ] as const) {
      figure.addEventListener(on, () => (paused = true));
      figure.addEventListener(off, () => (paused = false));
    }
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(figure);
    setInterval(() => {
      if (visible && !paused && !document.hidden) advance();
    }, 5000);
  }

  // Escreve o número no espelho quando ele entra na tela.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const mirror of document.querySelectorAll<HTMLElement>('[data-mirror]')) {
    if (reduce || !('IntersectionObserver' in window)) continue;
    mirror.dataset.state = 'waiting';
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        mirror.dataset.state = 'writing';
      },
      { rootMargin: '0px 0px -20% 0px' },
    );
    io.observe(mirror);
  }
</script>
