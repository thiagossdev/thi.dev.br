---
import { Image } from 'astro:assets';
import photo from '../assets/thiago.jpg';
import { site } from '../data/site';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/strings';
import Brand from './icons/Brand.astro';
import Ui from './icons/Ui.astro';

interface Props {
  locale: Locale;
}
const s = t(Astro.props.locale);
---

<section class="mx-auto max-w-4xl px-4 pt-14 pb-6 sm:px-6 sm:pt-20 sm:pb-10">
  <div class="grid items-center gap-10 md:grid-cols-[1fr_auto] md:gap-14">
    <div class="min-w-0">
      <p class="reveal text-sm text-text-muted" style="--i: 0">
        <span class="text-brand">thiago@thi.dev.br</span>:<span class="text-blue">~</span>$ whoami
      </p>

      <h1
        class="reveal mt-3 text-3xl font-bold tracking-[-0.022em] text-text sm:text-4xl lg:text-5xl"
        style="--i: 1"
      >
        {site.name}
      </h1>

      <p class="reveal mt-3 min-h-[1.75rem] text-lg text-text-secondary sm:text-xl" style="--i: 2">
        <span class="text-brand" aria-hidden="true">❯&nbsp;</span><span id="typed" class="cursor" data-phrases={JSON.stringify(s.hero.taglines)}>{s.hero.taglines[0]}</span>
      </p>

      <p class="reveal mt-6 max-w-[62ch] text-base leading-relaxed text-text-secondary" style="--i: 3">
        {s.hero.intro}
      </p>

      <div class="reveal mt-8 flex flex-wrap items-center gap-3" style="--i: 4">
        <a
          href="#projects"
          class="group inline-flex h-10 items-center gap-2 rounded-sm bg-brand pr-3.5 pl-4 text-sm font-semibold text-brand-ink transition-[transform,background-color] duration-150 ease-out active:scale-[0.97] [@media(hover:hover)]:hover:bg-[#bbdd97]"
        >
          {s.hero.cta}
          <Ui
            name="arrow-down"
            class="size-4 transition-transform duration-150 ease-out [@media(hover:hover)]:group-hover:translate-y-0.5"
          />
        </a>
        <ul class="flex flex-wrap gap-1.5" aria-label={s.a11y.social}>
          {
            site.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  rel="me noopener"
                  target="_blank"
                  aria-label={l.label}
                  title={l.label}
                  class="inline-flex size-10 items-center justify-center rounded-sm bg-surface text-text-secondary shadow-ring transition-[background-color,color,box-shadow,transform] duration-150 ease-out active:scale-[0.96] [@media(hover:hover)]:hover:bg-surface-2 [@media(hover:hover)]:hover:text-text [@media(hover:hover)]:hover:shadow-ring-hover"
                >
                  <Brand name={l.icon} class="size-[18px]" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <figure class="reveal justify-self-start md:justify-self-end" style="--i: 2">
      <Image
        src={photo}
        alt={s.a11y.photo}
        width={240}
        height={240}
        densities={[1, 2]}
        loading="eager"
        class="size-40 rounded-md bg-surface object-cover outline-1 -outline-offset-1 outline-[var(--t-img-outline)] shadow-ring sm:size-52 md:size-60"
      />
    </figure>
  </div>
</section>

<script>
  const el = document.getElementById('typed');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !reduce) {
    const phrases: string[] = JSON.parse(el.dataset.phrases ?? '[]');
    let index = 0;
    let text = phrases[0] ?? '';
    let deleting = false;

    const tick = () => {
      const target = phrases[index] ?? '';
      if (!deleting) {
        text = target.slice(0, text.length + 1);
        el.textContent = text;
        if (text === target) {
          deleting = true;
          setTimeout(tick, 2200);
          return;
        }
        setTimeout(tick, 55 + Math.random() * 45);
      } else {
        text = text.slice(0, -1);
        el.textContent = text;
        if (text.length === 0) {
          deleting = false;
          index = (index + 1) % phrases.length;
          setTimeout(tick, 350);
          return;
        }
        setTimeout(tick, 28);
      }
    };

    setTimeout(tick, 2600);
  }
</script>
