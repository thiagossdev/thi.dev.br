---
// Campo de pixels animado, reimplementado a partir das regras do campo do
// omarchy.org (hero e rodapé):
//
// - Cada célula de 11px tem uma intensidade h. Ela acende se h passar de um
//   limiar de pontilhado ordenado 8x8 misturado com um pouco de ruído fixo.
//   É desse limiar que saem os formatos de cruz e losango.
// - Fundo: h = peso * (0.3 + 0.52 * ruído² + 0.18 * cintilar) * 0.62.
//   hero  -> peso radial (mais denso nas bordas e cantos, mais leve no topo);
//   edges -> peso 0.3 que cai a zero perto do conteúdo.
//   Em ambos, elementos com data-field-mask zeram o peso com uma folga.
// - Ponteiro: soma (1 - d/alcance)² ao h, alcance de 12 células. Só existe
//   com o mouse; o tom (dim/mid/lit) vem dessa contribuição.
// - Clique: carimba o logo (glifo 15x15) que cresce e some.
// - Hero: equalizador de 32 bandas espelhado (graves nas bordas, agudos no
//   centro), com barras subindo do fundo. Não há áudio: a batida é
//   sintetizada a 126 BPM, bumbo em todo tempo.
//
// Pausa fora da tela e fica estático com prefers-reduced-motion.
interface Props {
  variant?: 'edges' | 'hero';
}
const { variant = 'edges' } = Astro.props;
---

<canvas data-pixel-field data-variant={variant} aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 size-full"
></canvas>

<script>
  const CELL = 11;
  const REACH = 12; // alcance do brilho, em células
  const BANDS = 32;

  // Pontilhado ordenado 8x8 (Bayer), normalizado para 0..1.
  const BAYER8 = (() => {
    let m = [[0]];
    while (m.length < 8) {
      const n = m.length;
      const next: number[][] = Array.from({ length: n * 2 }, () => new Array(n * 2).fill(0));
      for (let y = 0; y < n; y++)
        for (let x = 0; x < n; x++) {
          const v = m[y][x] * 4;
          next[y][x] = v;
          next[y][x + n] = v + 2;
          next[y + n][x] = v + 3;
          next[y + n][x + n] = v + 1;
        }
      m = next;
    }
    return m.flat().map((v) => (v + 0.5) / 64);
  })();

  // Logo carimbado no clique: o prompt "❯_" dentro de um quadro, 15x15.
  const GLYPH = [
    '111111111111111',
    '100000000000001',
    '101000000000001',
    '100100000000001',
    '100010000000001',
    '100001000000001',
    '100000100000001',
    '100001000000001',
    '100010000000001',
    '100100000000001',
    '101000011111001',
    '100000000000001',
    '100000000000001',
    '100000000000001',
    '111111111111111',
  ];

  const hash = (x: number, y: number) => {
    let h = (x * 374761393 + y * 668265263) | 0;
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  };
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const noise2 = (x: number, y: number) => {
    const xi = Math.floor(x);
    const yi = Math.floor(y);
    const xf = smooth(x - xi);
    const yf = smooth(y - yi);
    const a = hash(xi, yi);
    const b = hash(xi + 1, yi);
    const c = hash(xi, yi + 1);
    const d = hash(xi + 1, yi + 1);
    return (a * (1 - xf) + b * xf) * (1 - yf) + (c * (1 - xf) + d * xf) * yf;
  };
  const css = (name: string, fallback: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-pixel-field]')) {
    const host = canvas.parentElement;
    const ctx = canvas.getContext('2d');
    if (!host || !ctx) continue;

    const hero = canvas.dataset.variant === 'hero';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const colors = { dim: css('--t-field-dim', '#39482e'), mid: css('--t-field-mid', '#678549'), lit: css('--t-field-lit', '#9ece6a') };

    let width = 0;
    let height = 0;
    let cols = 0;
    let rows = 0;
    let weight = new Float32Array(0); // peso de fundo por célula
    let twinklePhase = new Float32Array(0);

    // Peso de fundo, recalculado quando o tamanho ou o layout mudam.
    const rebuild = () => {
      const rect = host.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(width / CELL);
      rows = Math.ceil(height / CELL);
      weight = new Float32Array(cols * rows);
      twinklePhase = new Float32Array(cols * rows);

      const masks = [...host.querySelectorAll<HTMLElement>('[data-field-mask]')].map((el) => {
        const r = el.getBoundingClientRect();
        return { l: r.left - rect.left, t: r.top - rect.top, r: r.right - rect.left, b: r.bottom - rect.top };
      });
      const falloff = hero ? 48 : 150; // px até o peso voltar ao normal
      const maskFactor = (x: number, y: number) => {
        let best = Infinity;
        for (const m of masks) {
          const dx = Math.max(m.l - x, 0, x - m.r);
          const dy = Math.max(m.t - y, 0, y - m.b);
          best = Math.min(best, Math.hypot(dx, dy));
        }
        return best >= falloff ? 1 : (best / falloff) ** 3;
      };

      for (let row = 0; row < rows; row++) {
        const cy = (row + 0.5) * CELL;
        for (let col = 0; col < cols; col++) {
          const cx = (col + 0.5) * CELL;
          let w: number;
          if (hero) {
            const ox = (cx / width) * 2 - 1;
            const oy = (cy / height) * 2 - 1;
            const radial = Math.min(1, Math.max(0, (Math.sqrt(ox * ox + oy * oy * 0.82) - 0.42) / 0.85));
            const top = Math.min(1, Math.max(0.16, (cy - 24) / 130));
            w = radial * radial * top;
          } else {
            w = 0.3;
          }
          weight[row * cols + col] = masks.length ? w * maskFactor(cx, cy) : w;
          twinklePhase[row * cols + col] = hash(row + 11, col + 29) * Math.PI * 2;
        }
      }
    };

    // Ponteiro e cliques.
    const pointer = { x: 0, y: 0, target: 0, strength: 0 };
    const ripples: { x: number; y: number; born: number }[] = [];
    const RIPPLE_LIFE = 1.4; // s

    // Equalizador sintetizado (só no hero).
    const levels = new Float32Array(BANDS);
    let beatPulse = 0;
    let lastT = -1;
    const updateMusic = (t: number) => {
      const dt = lastT < 0 ? 1 / 30 : Math.min(0.1, Math.max(0, t - lastT));
      lastT = t;
      const beat = (t * 126) / 60;
      const kick = Math.exp(-(beat % 1) * 5.5);
      const hat = Math.exp(-((beat + 0.5) % 1) * 9);
      const bar = Math.floor(beat / 4);
      const bass = [1, 0.6, 0.85, 0.55][Math.floor(beat) % 4];
      const build = 0.7 + 0.3 * Math.sin((bar % 8) * 0.785);
      const frames = dt * 30; // as taxas abaixo são por quadro a 30 fps
      for (let i = 0; i < BANDS; i++) {
        const f = i / (BANDS - 1); // 0 = grave, 1 = agudo
        const target =
          0.42 * kick * bass * Math.max(0, 1 - f * 2.2) ** 1.2 +
          0.28 * hat * f ** 1.5 +
          0.22 * noise2(t * 2.6 + i * 0.7, i) * build * (0.4 + 0.6 * Math.sin(f * Math.PI));
        const rate = target > levels[i] ? 0.7 : 0.14;
        levels[i] += (target - levels[i]) * (1 - (1 - rate) ** frames);
      }
      beatPulse = Math.max(beatPulse * 0.84 ** frames, kick > 0.9 ? kick : 0);
    };

    let now = 0; // relógio do desenho, em s
    const draw = (time: number) => {
      const t = reduce ? 0 : time / 1000;
      now = t;
      pointer.strength += (pointer.target - pointer.strength) * 0.3;
      if (hero && !reduce) updateMusic(t);
      while (ripples.length && t - ripples[0].born > RIPPLE_LIFE) ripples.shift();

      const reach = REACH * CELL * (0.45 + 0.55 * pointer.strength) * (1 + 0.8 * beatPulse);
      const buckets: Record<'dim' | 'mid' | 'lit', number[]> = { dim: [], mid: [], lit: [] };

      for (let row = 0; row < rows; row++) {
        const cy = (row + 0.5) * CELL;
        const fromBottom = rows - 1 - row;
        for (let col = 0; col < cols; col++) {
          const i = row * cols + col;
          const w = weight[i];
          const cx = (col + 0.5) * CELL;
          let h = 0;

          // Fundo: ruído que se move devagar e cintilar por célula.
          if (w > 0.002) {
            const nx = col / 9;
            const ny = row / 9;
            const n = 0.6 * noise2(nx + t * 0.14, ny - t * 0.055) + 0.4 * noise2(nx * 0.55 - t * 0.08, ny * 0.55 + t * 0.06);
            const tw = 0.5 + 0.5 * Math.sin(t * 1.1 + twinklePhase[i]);
            h = w * (0.3 + 0.52 * n * n + 0.18 * tw) * 0.62;
          }

          // Brilho do ponteiro: queda quadrática com a distância.
          let glow = 0;
          if (pointer.strength > 0.01) {
            const d = Math.hypot(cx - pointer.x, cy - pointer.y);
            if (d < reach) glow = (1 - d / reach) ** 2 * pointer.strength;
            h += glow * 0.6;
          }

          // Clique: logo carimbado que cresce e some.
          let stamp = 0;
          for (const r of ripples) {
            const p = (t - r.born) / RIPPLE_LIFE;
            const scale = CELL * (0.6 + 1.8 * (1 - (1 - p) ** 3));
            const gx = Math.floor((cx - r.x) / scale + 7.5);
            const gy = Math.floor((cy - r.y) / scale + 7.5);
            if (gx >= 0 && gy >= 0 && gx < 15 && gy < 15 && GLYPH[gy][gx] === '1') stamp = Math.max(stamp, (1 - p) ** 1.7);
          }
          h += stamp * 1.15;

          // Equalizador: barras subindo do fundo, graves nas bordas.
          let eq = 0;
          if (hero && w > 0.002) {
            const pos = (1 - Math.abs((col + 0.5) / cols - 0.5) * 2) * BANDS - 0.5;
            const a = Math.max(0, Math.min(BANDS - 1, Math.floor(pos)));
            const b = Math.min(BANDS - 1, a + 1);
            const f = Math.max(0, Math.min(1, pos - a));
            const level = Math.max(0, (levels[a] * (1 - f) + levels[b] * f - 0.08) / 0.92);
            const barHeight = level * rows * 0.92;
            if (level > 0 && fromBottom < barHeight) {
              eq = level * (1 - fromBottom / barHeight) ** 0.85;
              h += eq * 0.7 * Math.min(1, w * 3);
            }
          }

          const threshold = 0.78 * BAYER8[(row & 7) * 8 + (col & 7)] + 0.22 * hash(col & 63, (row & 63) + 101);
          if (h <= threshold) continue;
          const tone = Math.max(glow, stamp, eq * 0.5);
          buckets[tone > 0.34 ? 'lit' : tone > 0.1 ? 'mid' : 'dim'].push(col * CELL, row * CELL);
        }
      }

      ctx.clearRect(0, 0, width, height);
      for (const key of ['dim', 'mid', 'lit'] as const) {
        const list = buckets[key];
        if (!list.length) continue;
        ctx.fillStyle = colors[key];
        for (let k = 0; k < list.length; k += 2) ctx.fillRect(list[k], list[k + 1], CELL - 1, CELL - 1);
      }
    };

    // Redimensionar o canvas o limpa; com movimento reduzido não há laço
    // para redesenhar, então redesenha aqui.
    const relayout = () => {
      rebuild();
      if (reduce) draw(0);
    };
    relayout();
    new ResizeObserver(relayout).observe(host);
    // As máscaras dependem do layout final (fontes e animação de entrada).
    document.fonts?.ready.then(relayout);
    if (hero) setTimeout(relayout, 900);

    if (reduce) continue;

    const local = (e: PointerEvent) => {
      const r = host.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    };
    if (finePointer) {
      host.addEventListener('pointermove', (e) => {
        const p = local(e);
        pointer.x = p.x;
        pointer.y = p.y;
        pointer.target = 1;
      });
      host.addEventListener('pointerleave', () => (pointer.target = 0));
    }
    host.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      const p = local(e);
      ripples.push({ x: p.x, y: p.y, born: now });
    });

    // Anima só quando visível, a ~30 fps.
    let frame = 0;
    let last = 0;
    const loop = (time: number) => {
      frame = requestAnimationFrame(loop);
      if (time - last < 33) return;
      last = time;
      draw(time);
    };
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !frame) frame = requestAnimationFrame(loop);
        if (!entry.isIntersecting && frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      },
      { rootMargin: '64px' },
    ).observe(host);
  }
</script>
