---
// Campo de pixels animado inspirado no omarchy.org. Pixels isolados que
// acendem e apagam devagar, e losangos em xadrez que passeiam ou seguem
// o ponteiro. Pausa fora da tela e fica estático com prefers-reduced-motion.
//
// variant="edges" (rodapé): discreto, só pixels esparsos nas laterais fora
//   da coluna de conteúdo, e o losango só com o mouse; some em telas sem
//   lateral.
// variant="hero": a área toda, esparso no centro e mais denso nas laterais,
//   com uma onda pontilhada animada embaixo, como o hero do omarchy. O
//   losango só aparece com o mouse.
//
// Elementos com data-field-mask dentro do mesmo pai ficam sem pixels atrás.
interface Props {
  variant?: 'edges' | 'hero';
}
const { variant = 'edges' } = Astro.props;
---

<canvas data-pixel-field data-variant={variant} aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 size-full"></canvas>

<script>
  // Hash inteiro determinístico por célula.
  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);

  const hash = (x: number, y: number) => {
    let h = (x * 374761393 + y * 668265263) | 0;
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  };
  const css = (name: string, fallback: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-pixel-field]')) {
    const host = canvas.parentElement;
    const ctx = canvas.getContext('2d');
    if (!host || !ctx) continue;

    const hero = canvas.dataset.variant === 'hero';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const colors = {
      dim: css('--t-field-dim', '#39482e'),
      mid: css('--t-field-mid', '#678549'),
      lit: css('--t-field-lit', '#9ece6a'),
      hover: css('--t-field-hover', '#bbdd97'),
      crest: css('--t-field-crest', '#daecc6'),
    };

    let width = 0;
    let height = 0;
    const cell = 11; // passo da grade, como no omarchy
    const pointer = { x: -9999, y: -9999, active: false };

    const resize = () => {
      const rect = host.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    // Borda do conteúdo: mesma conta do .wrap (até 72rem, gutter de 1.5rem).
    const contentLeft = () => {
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      const max = 72 * rem;
      const gutter = width >= 40 * rem ? 1.5 * rem : rem;
      return Math.max(0, (width - max) / 2) + gutter;
    };

    // Peso da lateral: 0 dentro da coluna de conteúdo e num respiro de
    // GAP px ao redor dela (como no rodapé do omarchy), sobe até 1 depois.
    const GAP = 72;
    const edgeWeight = (x: number, left: number) => {
      const right = width - left;
      const d = (x < left ? left - x : x > right ? x - right : -1) - GAP;
      if (d < 0) return 0;
      return Math.min(1, d / 48);
    };

    const draw = (time: number) => {
      const t = time / 1000;
      const left = contentLeft();
      if (!hero && left < GAP + 48) {
        ctx.clearRect(0, 0, width, height);
        return;
      }
      const cols = Math.ceil(width / cell);
      const rows = Math.ceil(height / cell);
      const buckets: Record<keyof typeof colors, number[]> = { dim: [], mid: [], lit: [], hover: [], crest: [] };

      // O losango só aparece seguindo o ponteiro: no hero em qualquer ponto,
      // no rodapé só sobre as laterais.
      const glows: { x: number; y: number; hot: boolean }[] = [];
      if (pointer.active && (hero || edgeWeight(pointer.x, left) > 0)) glows.push({ x: pointer.x, y: pointer.y, hot: true });
      const glowCells = glows.map((g) => ({ col: Math.round(g.x / cell), row: Math.round(g.y / cell), hot: g.hot }));
      const RADIUS = hero ? 6 : 5; // em células

      // Áreas sem pixels (texto, foto), com uma folga em volta.
      const hostRect = host.getBoundingClientRect();
      const masks = [...host.querySelectorAll<HTMLElement>('[data-field-mask]')].map((el) => {
        const r = el.getBoundingClientRect();
        const pad = 16;
        return {
          x0: r.left - hostRect.left - pad,
          y0: r.top - hostRect.top - pad,
          x1: r.right - hostRect.left + pad,
          y1: r.bottom - hostRect.top + pad,
        };
      });
      const masked = (x: number, y: number) =>
        masks.some((m) => x + cell > m.x0 && x < m.x1 && y + cell > m.y0 && y < m.y1);

      // Onda do hero: o topo do "chão" pontilhado sobe e desce ao longo da largura.
      const waveRamp = width < 640 ? 110 : 170;
      const waveAmp = width < 640 ? 18 : 34;
      const waveTop = (x: number) =>
        height -
        waveRamp * 0.95 -
        waveAmp * (0.55 * Math.sin(x * 0.0065 + t * 0.5) + 0.3 * Math.sin(x * 0.017 - t * 0.35) + 0.15 * Math.sin(x * 0.041 + t * 0.8));

      for (let row = 0; row < rows; row++) {
        const y = row * cell;
        for (let col = 0; col < cols; col++) {
          const x = col * cell;
          if (masks.length && masked(x, y)) continue;
          const edge = edgeWeight(x + cell / 2, left);
          // Densidade de fundo por variante.
          let density: number;
          if (hero) {
            density = 0.018 + edge * 0.09;
          } else {
            if (edge <= 0) continue;
            density = 0.04 * edge;
          }

          // Losango: miolo sólido e anel em xadrez.
          let drawn = false;
          for (const g of glowCells) {
            const d = Math.abs(col - g.col) + Math.abs(row - g.row);
            if (d > RADIUS) continue;
            if (d <= 1 || (d <= RADIUS && (col + row) % 2 === 0 && (d < RADIUS - 1 || hash(col, row + 7) < 0.6))) {
              // Miolo claro, anel verde e borda escura, como o losango do omarchy.
              const tone = g.hot ? (d <= 1 ? 'crest' : 'hover') : d <= 1 ? 'hover' : d <= 4 ? 'lit' : 'mid';
              buckets[tone].push(x, y);
              drawn = true;
              break;
            }
          }
          if (drawn) continue;

          // Onda: abaixo da linha, pontilhado ordenado cada vez mais denso.
          if (hero) {
            const g = (y - waveTop(x)) / waveRamp;
            if (g > 0) {
              // Gradiente suave (nunca sólido), mais denso nos cantos, com um
              // pouco de ruído para quebrar o padrão regular do Bayer.
              const corner = Math.abs(x / width - 0.5) * 2;
              const level = Math.min(1, g) ** 1.4 * (0.62 + 0.28 * corner);
              const jitter = 0.7 * BAYER[(row % 4) * 4 + (col % 4)] + 0.3 * hash(col + 5, row);
              if (jitter < level) {
                buckets[level > 0.7 && hash(col, row + 3) < 0.3 ? 'lit' : level > 0.45 ? 'mid' : 'dim'].push(x, y);
              }
              continue;
            }
          }

          // Fundo: pixels isolados e esparsos que acendem e apagam devagar.
          const h = hash(col, row);
          if (h > density) continue;
          const phase = hash(row, col + 13) * 6.283;
          const twinkle = 0.5 + 0.5 * Math.sin(t * 0.5 + phase);
          if (twinkle < 0.3) continue;
          buckets[hero && h < density * 0.18 ? 'mid' : 'dim'].push(x, y);
        }
      }

      ctx.clearRect(0, 0, width, height);
      const size = cell - 1;
      for (const key of Object.keys(buckets) as (keyof typeof colors)[]) {
        const list = buckets[key];
        if (!list.length) continue;
        ctx.fillStyle = colors[key];
        for (let i = 0; i < list.length; i += 2) ctx.fillRect(list[i], list[i + 1], size, size);
      }
    };

    resize();
    new ResizeObserver(() => {
      resize();
      if (reduce) draw(0);
    }).observe(host);

    if (reduce) {
      draw(0);
      continue;
    }

    if (finePointer) {
      host.addEventListener('pointermove', (e) => {
        const rect = host.getBoundingClientRect();
        pointer.x = e.clientX - rect.left;
        pointer.y = e.clientY - rect.top;
        pointer.active = true;
      });
      host.addEventListener('pointerleave', () => (pointer.active = false));
    }

    // Anima só quando visível, a ~30 fps.
    let frame = 0;
    let last = 0;
    const loop = (time: number) => {
      frame = requestAnimationFrame(loop);
      if (time - last < 33) return;
      last = time;
      draw(time);
    };
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !frame) frame = requestAnimationFrame(loop);
        if (!entry.isIntersecting && frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      },
      { rootMargin: '64px' },
    ).observe(host);
  }
</script>
