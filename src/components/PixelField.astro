---
// Campo de pixels animado atrás do contato e do rodapé, inspirado no
// rodapé do omarchy.org: ruído que se move devagar, quantizado em blocos
// com pontilhado ordenado (Bayer 4x4) e um brilho que segue o ponteiro.
// Pausa fora da tela e fica estático com prefers-reduced-motion.
---

<canvas data-pixel-field aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 size-full"></canvas>

<script>
  const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);

  // Ruído de valor 2D suave, com hash inteiro determinístico.
  const hash = (x: number, y: number) => {
    let h = (x * 374761393 + y * 668265263) | 0;
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  };
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const noise = (x: number, y: number) => {
    const xi = Math.floor(x);
    const yi = Math.floor(y);
    const xf = smooth(x - xi);
    const yf = smooth(y - yi);
    const a = hash(xi, yi);
    const b = hash(xi + 1, yi);
    const c = hash(xi, yi + 1);
    const d = hash(xi + 1, yi + 1);
    return a + (b - a) * xf + (c - a) * yf + (a - b - c + d) * xf * yf;
  };

  const css = (name: string, fallback: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-pixel-field]')) {
    const host = canvas.parentElement;
    const ctx = canvas.getContext('2d');
    if (!host || !ctx) continue;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const colors = {
      dim: css('--t-field-dim', '#39482e'),
      mid: css('--t-field-mid', '#678549'),
      lit: css('--t-field-lit', '#9ece6a'),
      hover: css('--t-field-hover', '#bbdd97'),
      crest: css('--t-field-crest', '#daecc6'),
    };

    let width = 0;
    let height = 0;
    let cell = 10;
    const pointer = { x: -9999, y: -9999, active: false };

    const resize = () => {
      const rect = host.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      cell = width < 640 ? 8 : 10;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = (time: number) => {
      const t = time / 1000;
      const cols = Math.ceil(width / cell);
      const rows = Math.ceil(height / cell);
      const buckets: Record<keyof typeof colors, number[]> = { dim: [], mid: [], lit: [], hover: [], crest: [] };

      // Sem ponteiro, um ponto de luz passeia devagar pela faixa.
      const glowX = pointer.active ? pointer.x : width * (0.5 + 0.38 * Math.sin(t * 0.21));
      const glowY = pointer.active ? pointer.y : height * (0.72 + 0.12 * Math.sin(t * 0.17 + 1.3));
      const glowR = pointer.active ? 140 : 180;

      for (let row = 0; row < rows; row++) {
        const y = row * cell;
        // O campo sobe do rodapé: quase nada no topo, mais denso embaixo.
        const v = row / rows;
        const rise = Math.max(0, (v - 0.18) / 0.82);
        if (rise <= 0) continue;
        for (let col = 0; col < cols; col++) {
          const x = col * cell;
          const n =
            0.65 * noise(col * 0.09 + t * 0.12, row * 0.09 - t * 0.05) +
            0.35 * noise(col * 0.21 - t * 0.08, row * 0.21 + t * 0.04);
          const dx = x - glowX;
          const dy = y - glowY;
          const glow = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy) / glowR);
          const value = n * rise * 0.85 + glow * 0.55;
          const threshold = BAYER[(row % 4) * 4 + (col % 4)];
          if (value < threshold * 0.9 + 0.12) continue;

          const bucket =
            glow > 0.6 && pointer.active ? 'crest' : glow > 0.3 && pointer.active ? 'hover' : value > 0.78 ? 'lit' : value > 0.5 ? 'mid' : 'dim';
          buckets[bucket].push(x, y);
        }
      }

      ctx.clearRect(0, 0, width, height);
      const size = cell - 2;
      for (const key of Object.keys(buckets) as (keyof typeof colors)[]) {
        const list = buckets[key];
        if (!list.length) continue;
        ctx.fillStyle = colors[key];
        for (let i = 0; i < list.length; i += 2) ctx.fillRect(list[i], list[i + 1], size, size);
      }
    };

    resize();
    new ResizeObserver(() => {
      resize();
      if (reduce) draw(0);
    }).observe(host);

    if (reduce) {
      draw(0);
      continue;
    }

    if (finePointer) {
      host.addEventListener('pointermove', (e) => {
        const rect = host.getBoundingClientRect();
        pointer.x = e.clientX - rect.left;
        pointer.y = e.clientY - rect.top;
        pointer.active = true;
      });
      host.addEventListener('pointerleave', () => (pointer.active = false));
    }

    // Anima só quando visível, a ~30 fps.
    let frame = 0;
    let last = 0;
    const loop = (time: number) => {
      frame = requestAnimationFrame(loop);
      if (time - last < 33) return;
      last = time;
      draw(time);
    };
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !frame) frame = requestAnimationFrame(loop);
        if (!entry.isIntersecting && frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      },
      { rootMargin: '64px' },
    ).observe(host);
  }
</script>
