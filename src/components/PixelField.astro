---
// Campo de pixels animado atrás do contato e do rodapé, inspirado no
// rodapé do omarchy.org: só nas laterais, fora da coluna de conteúdo.
// Pixels isolados e esparsos que acendem e apagam devagar, e losangos
// em xadrez que passeiam ou seguem o ponteiro. Some quando
// não há lateral (telas estreitas), pausa fora da tela e fica estático
// com prefers-reduced-motion.
---

<canvas data-pixel-field aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 size-full"></canvas>

<script>
  // Hash inteiro determinístico por célula.
  const hash = (x: number, y: number) => {
    let h = (x * 374761393 + y * 668265263) | 0;
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  };
  const css = (name: string, fallback: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-pixel-field]')) {
    const host = canvas.parentElement;
    const ctx = canvas.getContext('2d');
    if (!host || !ctx) continue;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const colors = {
      dim: css('--t-field-dim', '#39482e'),
      mid: css('--t-field-mid', '#678549'),
      lit: css('--t-field-lit', '#9ece6a'),
      hover: css('--t-field-hover', '#bbdd97'),
      crest: css('--t-field-crest', '#daecc6'),
    };

    let width = 0;
    let height = 0;
    const cell = 11; // passo da grade, como no omarchy
    const pointer = { x: -9999, y: -9999, active: false };

    const resize = () => {
      const rect = host.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    // Borda do conteúdo: mesma conta do .wrap (até 72rem, gutter de 1.5rem).
    const contentLeft = () => {
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      const max = 72 * rem;
      const gutter = width >= 40 * rem ? 1.5 * rem : rem;
      return Math.max(0, (width - max) / 2) + gutter;
    };

    // Peso da lateral: 0 dentro da coluna de conteúdo, sobe até 1 nas bordas.
    const edgeWeight = (x: number, left: number) => {
      const right = width - left;
      const d = x < left ? left - x : x > right ? x - right : -1;
      if (d < 0) return 0;
      return Math.min(1, d / 64);
    };

    const draw = (time: number) => {
      const t = time / 1000;
      const left = contentLeft();
      if (left < 48) {
        ctx.clearRect(0, 0, width, height);
        return;
      }
      const cols = Math.ceil(width / cell);
      const rows = Math.ceil(height / cell);
      const buckets: Record<keyof typeof colors, number[]> = { dim: [], mid: [], lit: [], hover: [], crest: [] };

      // Um losango pontilhado passeia devagar em cada lateral, como o do
      // omarchy. Com mouse sobre uma lateral, outro segue o ponteiro.
      const glows = [
        { x: left * (0.5 + 0.28 * Math.sin(t * 0.11)), y: height * (0.35 + 0.22 * Math.sin(t * 0.08 + 0.8)), hot: false },
        { x: width - left * (0.5 + 0.28 * Math.sin(t * 0.09 + 2)), y: height * (0.62 + 0.22 * Math.sin(t * 0.07 + 2.4)), hot: false },
      ];
      if (pointer.active && edgeWeight(pointer.x, left) > 0) glows.push({ x: pointer.x, y: pointer.y, hot: true });
      const glowCells = glows.map((g) => ({ col: Math.round(g.x / cell), row: Math.round(g.y / cell), hot: g.hot }));
      const RADIUS = 5; // em células

      for (let row = 0; row < rows; row++) {
        const y = row * cell;
        for (let col = 0; col < cols; col++) {
          const x = col * cell;
          const edge = edgeWeight(x + cell / 2, left);
          if (edge <= 0) continue;

          // Losango: miolo sólido e anel em xadrez.
          let drawn = false;
          for (const g of glowCells) {
            const d = Math.abs(col - g.col) + Math.abs(row - g.row);
            if (d > RADIUS) continue;
            if (d <= 1 || (d <= RADIUS && (col + row) % 2 === 0 && (d < RADIUS - 1 || hash(col, row + 7) < 0.6))) {
              buckets[g.hot ? (d <= 1 ? 'crest' : 'hover') : d <= 2 ? 'lit' : 'mid'].push(x, y);
              drawn = true;
              break;
            }
          }
          if (drawn) continue;

          // Fundo: pixels isolados e esparsos que acendem e apagam devagar.
          const h = hash(col, row);
          if (h > 0.085 * edge) continue;
          const phase = hash(row, col + 13) * 6.283;
          const twinkle = 0.5 + 0.5 * Math.sin(t * 0.5 + phase);
          if (twinkle < 0.3) continue;
          buckets[h < 0.012 ? 'mid' : 'dim'].push(x, y);
        }
      }

      ctx.clearRect(0, 0, width, height);
      const size = cell - 1;
      for (const key of Object.keys(buckets) as (keyof typeof colors)[]) {
        const list = buckets[key];
        if (!list.length) continue;
        ctx.fillStyle = colors[key];
        for (let i = 0; i < list.length; i += 2) ctx.fillRect(list[i], list[i + 1], size, size);
      }
    };

    resize();
    new ResizeObserver(() => {
      resize();
      if (reduce) draw(0);
    }).observe(host);

    if (reduce) {
      draw(0);
      continue;
    }

    if (finePointer) {
      host.addEventListener('pointermove', (e) => {
        const rect = host.getBoundingClientRect();
        pointer.x = e.clientX - rect.left;
        pointer.y = e.clientY - rect.top;
        pointer.active = true;
      });
      host.addEventListener('pointerleave', () => (pointer.active = false));
    }

    // Anima só quando visível, a ~30 fps.
    let frame = 0;
    let last = 0;
    const loop = (time: number) => {
      frame = requestAnimationFrame(loop);
      if (time - last < 33) return;
      last = time;
      draw(time);
    };
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !frame) frame = requestAnimationFrame(loop);
        if (!entry.isIntersecting && frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      },
      { rootMargin: '64px' },
    ).observe(host);
  }
</script>
