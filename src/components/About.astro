---
import Section from './Section.astro';
import Ui, { type UiIconName } from './icons/Ui.astro';
import { site } from '../data/site';

const facts: { icon: UiIconName; label: string; value: string }[] = [
  { icon: 'map-pin', label: 'local', value: 'Teresina, PI' },
  { icon: 'languages', label: 'idiomas', value: 'português, inglês (B1/B2)' },
  { icon: 'briefcase', label: 'agora', value: 'RevGás, desde 2021' },
];

const hobbies: { icon: UiIconName; title: string; text: string }[] = [
  { icon: 'keyboard', title: 'teclados', text: 'Monto e customizo teclados mecânicos.' },
  { icon: 'gamepad', title: 'games', text: 'Jogando desde 1992, e às vezes fazendo os meus em Godot.' },
  { icon: 'headphones', title: 'música', text: 'Trilha sonora do dia inteiro, código incluso.' },
];
---

<Section id="sobre" title="sobre">
  <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_17rem] md:gap-14">
    <div class="space-y-4 text-base leading-relaxed text-text-secondary [&>p]:max-w-[62ch]">
      <p>
        Sou autodidata e busco sempre novos conhecimentos. Gosto de desafios, principalmente de
        entender o problema antes de partir para a solução.
      </p>
      <p>
        Gosto de estimar e organizar o tempo das tarefas e de estabelecer prazos realistas. Assim
        alinho o trabalho com a equipe e deixo o desenvolvimento fluir.
      </p>
      <p>
        Hoje trabalho na <a href="https://revgas.com" class="link" rel="noopener" target="_blank">RevGás</a>,
        em sistemas fiscais e gerenciais para revendas de GLP. Antes disso fui CTO da Expandr por
        seis anos, numa edtech de captação de alunos.
      </p>
    </div>

    <dl class="space-y-3 self-start text-sm">
      {
        facts.map((f) => (
          <div class="flex items-start gap-3">
            <dt class="flex w-24 shrink-0 items-center gap-2 text-text-muted">
              <Ui name={f.icon} class="size-4 text-brand" />
              {f.label}
            </dt>
            <dd class="text-text">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <ul class="mt-12 grid gap-6 sm:grid-cols-3" aria-label="Fora do código">
    {
      hobbies.map((h) => (
        <li class="flex gap-3">
          <Ui name={h.icon} class="mt-0.5 size-5 shrink-0 text-brand" />
          <div>
            <p class="text-sm font-semibold text-text">{h.title}</p>
            <p class="mt-1 text-sm leading-relaxed text-text-muted">{h.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
