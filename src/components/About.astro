---
import Section from './Section.astro';
import Ui, { type UiIconName } from './icons/Ui.astro';
import { site } from '../data/site';
import type { Locale } from '../i18n/config';
import { t } from '../i18n/strings';
import { cvPdfPath } from '../i18n/config';
import Download from '@lucide/astro/icons/download';

interface Props {
  locale: Locale;
}
const s = t(Astro.props.locale);
const cvHref = cvPdfPath(Astro.props.locale);
const a = s.about;

const facts: { icon: UiIconName; label: string; value: string; href?: string }[] = [
  { icon: 'map-pin', label: a.facts.location, value: site.location },
  { icon: 'languages', label: a.facts.languages, value: a.languagesValue },
  { icon: 'briefcase', label: a.facts.now, value: a.nowValue },
  { icon: 'terminal', label: a.facts.os, value: 'Omarchy', href: 'https://omarchy.org' },
  { icon: 'square-terminal', label: a.facts.shell, value: 'zsh', href: 'https://www.zsh.org' },
];

const hobbies: { icon: UiIconName; title: string; text: string }[] = [
  { icon: 'keyboard', ...a.hobbies.keyboards },
  { icon: 'gamepad', ...a.hobbies.games },
  { icon: 'headphones', ...a.hobbies.music },
];
---

<Section id="about" title={s.nav.about}>
  <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_18rem] md:gap-16">
    <div class="space-y-4 text-base leading-relaxed text-text-secondary [&>p]:max-w-[62ch]">
      {a.paragraphs.map((p) => <p>{p}</p>)}
      <p>
        {a.current.before}<a href="https://revgas.com" class="link" rel="noopener" target="_blank">RevGás</a>{a.current.after}
      </p>
    </div>

    <div class="self-start">
    <dl class="space-y-3 text-sm">
      {
        facts.map((f) => (
          <div class="flex items-start gap-3">
            <dt class="flex w-28 shrink-0 items-center gap-2 text-text-muted">
              <Ui name={f.icon} class="size-4 text-brand" />
              {f.label}
            </dt>
            <dd class="text-text">
              {f.href ? (
                <a href={f.href} class="link" rel="noopener" target="_blank">
                  {f.value}
                </a>
              ) : (
                f.value
              )}
            </dd>
          </div>
        ))
      }
    </dl>
      <div class="pt-5">
        <a
          href={cvHref}
          download
          class="group inline-flex h-10 items-center gap-2 rounded-sm bg-surface pr-3.5 pl-4 text-sm font-semibold text-text shadow-ring transition-[transform,background-color,box-shadow] duration-150 ease-out active:scale-[0.97] [@media(hover:hover)]:hover:bg-surface-2 [@media(hover:hover)]:hover:shadow-ring-hover"
        >
          {s.hero.cv}
          <Download class="size-4 text-brand" stroke-width={1.5} stroke-linecap="square" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>

  <ul class="mt-12 grid gap-6 sm:grid-cols-3" aria-label={a.offCode}>
    {
      hobbies.map((h) => (
        <li class="flex gap-3">
          <Ui name={h.icon} class="mt-0.5 size-5 shrink-0 text-brand" />
          <div>
            <p class="text-sm font-semibold text-text">{h.title}</p>
            <p class="mt-1 max-w-[40ch] text-sm leading-relaxed text-text-muted">{h.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
